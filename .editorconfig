# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Baseline
[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
max_line_length = 150
tab_width = 4
trim_trailing_whitespace = true

# CPP 源文件的设置
[*.{h,cpp}]
charset = utf-8
end_of_line = lf
file_header_template = Copyright (c) 2026, LJason. All Rights Reserved.
indent_size = 4
indent_style = space
max_line_length = 150
tab_width = 4
trim_trailing_whitespace = true

# INI 文件的设置
[*.ini]
charset = utf-8
end_of_line = lf

# C# 文件的设置
[*.cs]
charset = utf-8
end_of_line = lf
file_header_template = Copyright (c) 2026, LJason. All Rights Reserved.
indent_size = 4
indent_style = space
max_line_length = 150
tab_width = 4
trim_trailing_whitespace = true

# 虚幻项目文件的设置
[*.{uproject,uplugin}]
charset = utf-8
end_of_line = lf
indent_style = tab

# 脚本文件的设置
[*.{bat,ps1}]
end_of_line = crlf

# Markdown 文件的设置
[*.md]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
