[attr]lock filter=lfs diff=lfs merge=lfs -text lockable
[attr]lockonly lockable
[attr]lfs filter=lfs diff=lfs merge=lfs -text
[attr]lfstext filter=lfs diff=lfstext merge=lfstext -text
[attr]binary filter=lfs diff=lfs merge=lfs binary

# 虚幻文件类型
*.uasset lock
*.umap lock
*.uplugin text eol=lf encoding=utf-8
*.uproject text eol=lf encoding=utf-8
*.upack binary
*.ddc binary

# Steam Audio files
*.phononscene lfs
*.probebox lfs
*.probebatch lfs
*.bakedsources lfs

# FMOD
*.bank lfs
*.wav lfs
*.mp3 lfs
*.ogg lfs
*.flac lfs

# Movies
*.bk2 lfs

# 3D 模型
*.blend lfs
*.fbx lfs
*.glb lfs

# 压缩包
*.7z binary
*.br binary
*.gz binary
*.tar binary
*.zip binary

# 图片
*.gif binary
*.icns binary
*.ico binary
*.jpg binary
*.pdf binary
*.png binary
*.psd binary
*.webp binary

# 字体
*.woff2 binary

# 二进制文件
*.exe binary
*.dll binary
*.rcc binary

# 强制批处理脚本始终使用 CRLF 行结束符。
# 这样如果在 Windows 中通过文件共享从 Linux 访问 repo，脚本就能正常工作。
*.{cmd,[cC][mM][dD]} text eol=crlf
*.{bat,[bB][aA][tT]} text eol=crlf
*.ps1 text eol=crlf

# 强制 bash 脚本始终使用 LF 行结束符。
# 这样如果在 Unix 中通过文件共享从 Windows 访问 repo，脚本就能正常工作。
*.sh text eol=lf

# 配置文件
/Config/**/*.ini text eol=lf encoding=utf-8

# 声明在检出时始终以 LF 行结尾的文件。
*.cpp text eol=lf encoding=utf-8
*.cs text eol=lf encoding=utf-8
*.h text eol=lf encoding=utf-8

# 本地化文件
*.archive diff working-tree-encoding=UTF-16LE-BOM eol=CRLF
*.manifest diff working-tree-encoding=UTF-16LE-BOM eol=CRLF
